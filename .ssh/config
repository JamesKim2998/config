Include config.local

Host github.com
  AddKeysToAgent yes
  UseKeychain yes
  # No IdentityFile here. It accumulates across Include, so a key named in this
  # shared block is tried on every machine and warned about wherever the file
  # is missing. Each machine names its key in config.local, or relies on ssh's
  # defaults (~/.ssh/id_rsa, id_ed25519, …), which stay silent when absent.
  ControlMaster auto
  ControlPath ~/.ssh/cm-%r@%h:%p
  ControlPersist 10m
  ServerAliveInterval 60

# Mac Mini server (Tailscale - works from anywhere)
Host macmini macmini.studioboxcat.com
  HostName macmini.studioboxcat.com
  User jameskim
  IdentityFile ~/.ssh/james-macmini
  AddKeysToAgent yes
  UseKeychain yes
  ControlMaster auto
  ControlPath ~/.ssh/cm-%r@%h:%p
  ControlPersist 10m
  ServerAliveInterval 60
